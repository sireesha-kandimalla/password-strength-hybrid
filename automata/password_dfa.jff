<?xml version="1.0" encoding="UTF-8"?>
<!-- JFLAP 7.1 XML Format for Password Policy DFA -->
<structure>
  <type>fa</type>
  <automaton>
    <!-- 16 Subsets for Character Categories: (U=8, L=4, D=2, S=1) -->
    <!-- State q0 (0000): Start, nothing seen -->
    <state id="0" name="q0000">
      <x>100.0</x>
      <y>100.0</y>
      <initial/>
    </state>
    <!-- Single Category States -->
    <state id="1" name="q0001_S">
      <x>260.0</x>
      <y>100.0</y>
    </state>
    <state id="2" name="q0010_D">
      <x>420.0</x>
      <y>100.0</y>
    </state>
    <state id="4" name="q0100_L">
      <x>580.0</x>
      <y>100.0</y>
    </state>
    <state id="8" name="q1000_U">
      <x>740.0</x>
      <y>100.0</y>
    </state>
    <!-- Two Category States -->
    <state id="3" name="q0011_DS">
      <x>180.0</x>
      <y>240.0</y>
    </state>
    <state id="5" name="q0101_LS">
      <x>340.0</x>
      <y>240.0</y>
    </state>
    <state id="6" name="q0110_LD">
      <x>500.0</x>
      <y>240.0</y>
    </state>
    <state id="9" name="q1001_US">
      <x>660.0</x>
      <y>240.0</y>
    </state>
    <state id="10" name="q1010_UD">
      <x>820.0</x>
      <y>240.0</y>
    </state>
    <state id="12" name="q1100_UL">
      <x>980.0</x>
      <y>240.0</y>
    </state>
    <!-- Three Category States -->
    <state id="7" name="q0111_LDS">
      <x>260.0</x>
      <y>380.0</y>
    </state>
    <state id="11" name="q1011_UDS">
      <x>460.0</x>
      <y>380.0</y>
    </state>
    <state id="13" name="q1101_ULS">
      <x>660.0</x>
      <y>380.0</y>
    </state>
    <state id="14" name="q1110_ULD">
      <x>860.0</x>
      <y>380.0</y>
    </state>
    <!-- Four Category State (All Seen) -->
    <state id="15" name="q1111_ALL">
      <x>560.0</x>
      <y>520.0</y>
      <final/>
    </state>

    <!-- Transitions for State 0 (0000) -->
    <transition><from>0</from><to>8</to><read>U</read></transition>
    <transition><from>0</from><to>4</to><read>L</read></transition>
    <transition><from>0</from><to>2</to><read>D</read></transition>
    <transition><from>0</from><to>1</to><read>S</read></transition>

    <!-- Transitions for State 1 (0001: S) -->
    <transition><from>1</from><to>9</to><read>U</read></transition>
    <transition><from>1</from><to>5</to><read>L</read></transition>
    <transition><from>1</from><to>3</to><read>D</read></transition>
    <transition><from>1</from><to>1</to><read>S</read></transition>

    <!-- Transitions for State 2 (0010: D) -->
    <transition><from>2</from><to>10</to><read>U</read></transition>
    <transition><from>2</from><to>6</to><read>L</read></transition>
    <transition><from>2</from><to>2</to><read>D</read></transition>
    <transition><from>2</from><to>3</to><read>S</read></transition>

    <!-- Transitions for State 3 (0011: DS) -->
    <transition><from>3</from><to>11</to><read>U</read></transition>
    <transition><from>3</from><to>7</to><read>L</read></transition>
    <transition><from>3</from><to>3</to><read>D</read></transition>
    <transition><from>3</from><to>3</to><read>S</read></transition>

    <!-- Transitions for State 4 (0100: L) -->
    <transition><from>4</from><to>12</to><read>U</read></transition>
    <transition><from>4</from><to>4</to><read>L</read></transition>
    <transition><from>4</from><to>6</to><read>D</read></transition>
    <transition><from>4</from><to>5</to><read>S</read></transition>

    <!-- Transitions for State 5 (0101: LS) -->
    <transition><from>5</from><to>13</to><read>U</read></transition>
    <transition><from>5</from><to>5</to><read>L</read></transition>
    <transition><from>5</from><to>7</to><read>D</read></transition>
    <transition><from>5</from><to>5</to><read>S</read></transition>

    <!-- Transitions for State 6 (0110: LD) -->
    <transition><from>6</from><to>14</to><read>U</read></transition>
    <transition><from>6</from><to>6</to><read>L</read></transition>
    <transition><from>6</from><to>6</to><read>D</read></transition>
    <transition><from>6</from><to>7</to><read>S</read></transition>

    <!-- Transitions for State 7 (0111: LDS) -->
    <transition><from>7</from><to>15</to><read>U</read></transition>
    <transition><from>7</from><to>7</to><read>L</read></transition>
    <transition><from>7</from><to>7</to><read>D</read></transition>
    <transition><from>7</from><to>7</to><read>S</read></transition>

    <!-- Transitions for State 8 (1000: U) -->
    <transition><from>8</from><to>8</to><read>U</read></transition>
    <transition><from>8</from><to>12</to><read>L</read></transition>
    <transition><from>8</from><to>10</to><read>D</read></transition>
    <transition><from>8</from><to>9</to><read>S</read></transition>

    <!-- Transitions for State 9 (1001: US) -->
    <transition><from>9</from><to>9</to><read>U</read></transition>
    <transition><from>9</from><to>13</to><read>L</read></transition>
    <transition><from>9</from><to>11</to><read>D</read></transition>
    <transition><from>9</from><to>9</to><read>S</read></transition>

    <!-- Transitions for State 10 (1010: UD) -->
    <transition><from>10</from><to>10</to><read>U</read></transition>
    <transition><from>10</from><to>14</to><read>L</read></transition>
    <transition><from>10</from><to>10</to><read>D</read></transition>
    <transition><from>10</from><to>11</to><read>S</read></transition>

    <!-- Transitions for State 11 (1011: UDS) -->
    <transition><from>11</from><to>11</to><read>U</read></transition>
    <transition><from>11</from><to>15</to><read>L</read></transition>
    <transition><from>11</from><to>11</to><read>D</read></transition>
    <transition><from>11</from><to>11</to><read>S</read></transition>

    <!-- Transitions for State 12 (1100: UL) -->
    <transition><from>12</from><to>12</to><read>U</read></transition>
    <transition><from>12</from><to>12</to><read>L</read></transition>
    <transition><from>12</from><to>14</to><read>D</read></transition>
    <transition><from>12</from><to>13</to><read>S</read></transition>

    <!-- Transitions for State 13 (1101: ULS) -->
    <transition><from>13</from><to>13</to><read>U</read></transition>
    <transition><from>13</from><to>13</to><read>L</read></transition>
    <transition><from>13</from><to>15</to><read>D</read></transition>
    <transition><from>13</from><to>13</to><read>S</read></transition>

    <!-- Transitions for State 14 (1110: ULD) -->
    <transition><from>14</from><to>14</to><read>U</read></transition>
    <transition><from>14</from><to>14</to><read>L</read></transition>
    <transition><from>14</from><to>14</to><read>D</read></transition>
    <transition><from>14</from><to>15</to><read>S</read></transition>

    <!-- Transitions for State 15 (1111: ALL) -->
    <transition><from>15</from><to>15</to><read>U</read></transition>
    <transition><from>15</from><to>15</to><read>L</read></transition>
    <transition><from>15</from><to>15</to><read>D</read></transition>
    <transition><from>15</from><to>15</to><read>S</read></transition>
  </automaton>
</structure>
